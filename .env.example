# Deep Link Configuration (for Electron/mobile app)
# Set USE_DEEP_LINKS=true to enable deep link URLs in emails and OAuth redirects
USE_DEEP_LINKS=true
# The custom URL scheme registered in the Electron/mobile app (e.g. bloommonie)
APP_DEEP_LINK_SCHEME=bloommonie
# Web fallback URLs (used when USE_DEEP_LINKS=false or as fallback)
APP_LOGIN_URL=http://localhost:5173/login
APP_DASHBOARD_URL=http://localhost:5173/dashboard
# Google OAuth callback URL for web (deep link callback is built automatically from APP_DEEP_LINK_SCHEME)
APP_GOOGLE_CALLBACK_URL=http://localhost:5173/auth/google/callback
